# Password database — dipakai oleh docker-compose untuk inisialisasi MariaDB
DB_ROOT_PASSWORD=ganti_root_password_kuat
DB_DATABASE=bumdesmart
DB_USERNAME=bumdesmart_user
DB_PASSWORD=ganti_dengan_password_kuat

# URL API yang dipakai frontend (di-bake saat build image)
# Ganti dengan IP/domain server
NEXT_PUBLIC_API_URL=http://192.168.1.206/api/v1
