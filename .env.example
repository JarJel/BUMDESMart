# =============================================================================
# BUMDeSMart — Root .env (dibaca oleh docker-compose)
# Salin ke .env lalu isi semua nilainya sebelum "docker compose up"
# =============================================================================

# --- Database MariaDB ---
DB_ROOT_PASSWORD=ganti_root_password_kuat
DB_DATABASE=bumdesmart
DB_USERNAME=bumdesmart_user
DB_PASSWORD=ganti_dengan_password_kuat

# --- Domain & URL ---
# Lokal Docker : kosongkan atau isi ":80" (HTTP biasa tanpa TLS)
# Production   : isi nama domain, Caddy auto-HTTPS via Let's Encrypt
CADDY_DOMAIN=:80

# URL API yang di-bake ke dalam image frontend saat build
# Lokal Docker : http://localhost/api/v1
# Production   : https://bumdesmartnukita.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# --- Midtrans ---
# SANDBOX (testing):
#   Ambil dari dashboard.sandbox.midtrans.com → Settings → Access Keys
#   Set MIDTRANS_IS_PRODUCTION=false
# PRODUCTION (live):
#   Ambil dari dashboard.midtrans.com → Settings → Access Keys
#   Set MIDTRANS_IS_PRODUCTION=true
# PENTING: keys di root .env HARUS SAMA dengan di backend/.env!
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Google OAuth (login dengan Google) ---
# Ambil dari console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# WAJIB DIISI supaya tombol Google login muncul di frontend!
GOOGLE_CLIENT_ID=

# --- Fitur opsional ---
NEXT_PUBLIC_WHATSAPP_GATEWAY_ENABLED=false

# --- Cloudflare Tunnel (opsional, untuk production) ---
TUNNEL_TOKEN=
