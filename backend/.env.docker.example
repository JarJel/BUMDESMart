APP_NAME=BUMDeSMart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.206
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

FRONTEND_URL=http://192.168.1.206

LOG_CHANNEL=stack
LOG_LEVEL=error

# DB_HOST harus "db" (nama container MariaDB di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
