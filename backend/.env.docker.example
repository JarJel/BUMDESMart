APP_NAME=BUMDeSMart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Lokal/kampus: http://192.168.1.206 | Production: https://bumdesmartnukita.com
APP_URL=https://bumdesmartnukita.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# Lokal/kampus: http://192.168.1.206 | Production: https://bumdesmartnukita.com
FRONTEND_URL=https://bumdesmartnukita.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# DB_HOST harus "db" (nama container MariaDB di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bumdesmart
DB_USERNAME=bumdesmart_user
DB_PASSWORD=ganti_dengan_password_kuat

# Redis host harus "redis" (nama container)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=bumdesmart00@gmail.com
# Generate di: myaccount.google.com/apppasswords (bukan password biasa!)
MAIL_PASSWORD=ISI_APP_PASSWORD_GMAIL_DI_SINI
MAIL_FROM_ADDRESS="bumdesmart00@gmail.com"
MAIL_FROM_NAME="BUMDeSMart"

# Lokal/kampus: 192.168.1.206 | Production: bumdesmartnukita.com
# Pisahkan beberapa domain dengan koma tanpa spasi
SANCTUM_STATEFUL_DOMAINS=192.168.1.206,bumdesmartnukita.com

RAJAONGKIR_API_KEY=

# Ambil dari dashboard Midtrans → Settings → Access Keys
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Mxxxxxxxxx
MIDTRANS_IS_PRODUCTION=true

# WhatsApp via Fonnte (alternatif OpenWA)
FONTE_TOKEN=
FONTE_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_DRIVER=openwa

# OpenWA — jalankan terpisah di host, bukan di dalam Docker
# Scan QR di: http://<IP-SERVER>:2785
# Lokal: http://host.docker.internal:2785 | Server: http://192.168.1.206:2785
OPENWA_URL=http://host.docker.internal:2785
OPENWA_SESSION_ID=bumdesmart
OPENWA_API_KEY=
