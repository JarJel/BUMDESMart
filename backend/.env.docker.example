APP_NAME=BUMDeSMart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Lokal Docker: http://localhost | Production: https://domain-anda.com
APP_URL=https://bumdesmartnukita.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# Lokal Docker: http://localhost | Production: https://domain-anda.com
FRONTEND_URL=https://bumdesmartnukita.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# DB_HOST harus "db" (nama container MariaDB di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bumdesmart
DB_USERNAME=bumdesmart_user
DB_PASSWORD=ganti_dengan_password_kuat

# Redis host harus "redis" (nama container)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=bumdesmart00@gmail.com
# Generate di: myaccount.google.com/apppasswords (bukan password biasa!)
MAIL_PASSWORD=ISI_APP_PASSWORD_GMAIL_DI_SINI
MAIL_FROM_ADDRESS="bumdesmart00@gmail.com"
MAIL_FROM_NAME="BUMDeSMart"

# Domain yang boleh set Sanctum session cookie
SANCTUM_STATEFUL_DOMAINS=bumdesmartnukita.com

RAJAONGKIR_API_KEY=

# --- Midtrans ---
# SANDBOX (testing/dev):
#   Server: dari dashboard.sandbox.midtrans.com → Settings → Access Keys
#   IS_PRODUCTION=false
# PRODUCTION (live):
#   Server: dari dashboard.midtrans.com → Settings → Access Keys
#   IS_PRODUCTION=true
# PENTING: SERVER_KEY, CLIENT_KEY, dan IS_PRODUCTION harus MATCH environment yang sama!
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Mxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Google OAuth ---
# Ambil dari console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# WAJIB DIISI supaya tombol Google login muncul di frontend!
GOOGLE_CLIENT_ID=

# WhatsApp via Fonnte (alternatif OpenWA)
FONTE_TOKEN=
FONTE_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_DRIVER=openwa

# OpenWA — jalankan terpisah di host
OPENWA_URL=http://openwa:2785
OPENWA_SESSION_ID=bumdesmart
OPENWA_API_KEY=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
